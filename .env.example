# ============================================================
# Connekt Pay — Environment Variables Reference
# ============================================================
# Copie este arquivo para .env.local antes de editar:
#   copy .env.example .env.local
# Nunca commit .env.local nem valores reais neste arquivo.
# ============================================================

# ------------------------------------------------------------
# [1] GERAIS DA APLICAÇÃO
# ------------------------------------------------------------

# Obrigatoria. Define qual provedor financeiro está ativo.
# Valores aceitos:
#   - "pagarme"   : Provider em migração/uso atual (Sandbox ou Production)
#   - "mygateway" : Provider legado (rollback explícito onde aplicável)
FINANCIAL_PROVIDER=pagarme

# Obrigatoria para rodar localmente com RC (não usar em preview/production sem necessidade).
# Usado pelo runner Playwright em camada full/local-regression.
# Exemplo: http://localhost:3001
# BASE_URL=http://localhost:3001

# Opcional. Habilita a rota de pagamento standalone (recebimento direto sem payment link).
# Padrão: false
STANDALONE_PAYMENTS_ENABLED=false

# ------------------------------------------------------------
# [2] SUPABASE (Autenticação, Banco, Storage)
# ------------------------------------------------------------
# Todas são obrigatórias. Obtenha no painel do Supabase → Project Settings → API.

# Pública (client-side). Pode ir para o navegador.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=SEU-ANON-KEY-PUBLICO

# Privada (server-side APENAS). NÃO expor no navegador, não logar.
# Usado por admin, provisionamento, webhooks e rotas internas.
SUPABASE_SERVICE_ROLE_KEY=SEU-SERVICE-ROLE-KEY-PRIVADO

# ------------------------------------------------------------
# [3] PAGAR.ME (Provider Atual / Em Migração)
# ------------------------------------------------------------
# Usado quando FINANCIAL_PROVIDER=pagarme.

# Base URL por ambiente:
#   Sandbox    : https://sdx-api.pagar.me/core/v5
#   Production : https://api.pagar.me/core/v5
PAGARME_BASE_URL=https://sdx-api.pagar.me/core/v5
NEXT_PUBLIC_PAGARME_BASE_URL=https://sdx-api.pagar.me/core/v5

# Chave secreta (server-side APENAS).
# Sandbox    : começa com sk_test_
# Production : começa com sk_live_
PAGARME_SECRET_KEY=

# App ID público usado no SDK de tokenização de cartão client-side.
NEXT_PUBLIC_PAGARME_APP_ID=

# Opcional. Liga/desliga criação de payment links via API Pagar.me.
# Enquanto o provider não está homologado, manter false (modo interno demo).
PAGARME_PAYMENT_LINKS_ENABLED=false

# Autenticação HTTP Basic do webhook Pagar.me.
# Cadastre o mesmo par usuário:senha no painel da Pagar.me (hooks → Basic Auth).
# Server-side APENAS.
PAGARME_WEBHOOK_USERNAME=
PAGARME_WEBHOOK_PASSWORD=

# ------------------------------------------------------------
# [4] MYGATEWAY (Provider Legado / Rollback)
# ------------------------------------------------------------
# Usado quando FINANCIAL_PROVIDER=mygateway.
# Mantidos no código para rollback explícito; não remover sem confirmar desuso.

MYGATEWAY_BASE_URL=
MYGATEWAY_X_API_KEY=
MYGATEWAY_AUTH_DATA=
MYGATEWAY_AUTH_HEADER=Authorization
# Se false, payment links operam em modo interno demo.
MYGATEWAY_PAYMENT_LINKS_ENABLED=false
MYGATEWAY_WEBHOOK_SECRET=

# ------------------------------------------------------------
# [5] FLUXOS INTERNOS / RECEIVER / KYC
# ------------------------------------------------------------
# Ativam módulos internos independentemente do provider externo.

# Recebedores operam 100% no banco interno (recomendado true).
INTERNAL_RECEIVERS_FLOW_ENABLED=true

# KYC com upload e aprovação administrativa interna (recomendado true).
INTERNAL_KYC_FLOW_ENABLED=true

# Opcional. Envia receiver criado/atualizado para o provider externo.
# Manter false enquanto não houver homologação real de receiver/KYC.
RECEIVER_PROVIDER_SYNC_ENABLED=false

# Opcional. Submete KYC no MyGateway. Manter false.
MYGATEWAY_KYC_ENABLED=false

# ------------------------------------------------------------
# [6] WEBHOOKS, CRON E EVENTOS ASSÍNCRONOS
# ------------------------------------------------------------

# Segredo compartilhado para chamadas /api/events/process-pending e CRONs.
# Qualquer string longa e aleatória. Server-side APENAS.
CRON_SECRET=
EVENTS_PROCESS_SECRET=

# ------------------------------------------------------------
# [7] E-MAIL / TRANSAÇÕES (SENDGRID)
# ------------------------------------------------------------
# Opcional até precisar de envio real de transacionais.

SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=contato@exemplo.com
SENDGRID_FROM_NAME=Connekt Pay
